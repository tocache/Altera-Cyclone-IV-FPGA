library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.std_logic_arith.all;
use IEEE.std_logic_unsigned.all;

entity CONT_8B is
	port(	in_clk:	in std_logic;
			Q:			out std_logic_vectotr(7 downto 0));
end CLK_DIV1;

architecture funcionamiento of CLK_DIV1 is
signal interno: std_logic_vector(7 downto 0);
begin
	process(in_clk)
	begin
		if rising_edge(in_clk) then
			interno <= interno + 1;
		end if;
	end process;
	Q <= interno;
--	Q(7) <= interno(7);
--	Q(6) <= interno(6);
--	Q(5) <= interno(5);
--	Q(4) <= interno(4);
--	Q(3) <= interno(3);
--	Q(2) <= interno(2);
--	Q(1) <= interno(1);
--	Q(0) <= interno(0);
	
end funcionamiento;